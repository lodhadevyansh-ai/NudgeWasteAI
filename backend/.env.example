# Application Settings
APP_NAME=NudgeWasteAI Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database Settings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nudgewaste_db

# Machine Learning Settings
ML_MODEL_ENABLED=True
ML_CHECKPOINT_PATH=Machine_Learning/models/trained/nudgewaste_mobilenetv3_small_best.pt
ML_MODEL_VERSION=v1.0.0-mobilenetv3-small

# Security & JWT Settings
JWT_SECRET_KEY=YOUR_SECURE_GENERATED_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
